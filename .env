API_BASE_URL=https://be.sb21.net/api/v2
API_TIMEOUT=10
LOG_LEVEL=INFO
DATABASE_URL=postgresql://football:football@db:5432/football
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=change-me-in-production-to-a-random-string

# Telegram OTP (login + idle-lock unlock)
# BOT_TOKEN: from @BotFather. CHAT_IDS: comma-separated chat ids to receive every OTP.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# OTP expiry in seconds (default 300 = 5 min)
TELEGRAM_OTP_TTL=300
# Idle lock timeout in seconds (default 300 = 5 min)
IDLE_LOCK_SECONDS=300
