# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://football:football@db:5432/football

# ── Auth ──────────────────────────────────────────────────────────────────────
APP_ENV=prod
SECRET_KEY=
TOKEN_EXPIRE_HOURS=24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Collector ───────────────────────────────────────────────────────────────
API_BASE_URL=https://be.sb21.net/api/v2
API_TIMEOUT=10
POLL_INTERVAL=30
UPCOMING_FAST_WINDOW_MIN=30
UPCOMING_FAST_INTERVAL=60
STALE_FT_HOURS=6

# ── Telegram (OTP + alerts) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_OTP_TTL=300
IDLE_LOCK_SECONDS=300

# ── AI / LLM (OpenAI-compatible) — OPTIONAL ──────────────────────────────────
# Có cả 3 biến bắt buộc thì tính năng AI bật; thiếu bất kỳ biến nào → tự tắt.
# Trạng thái + nút "Kiểm tra" hiển thị trên header trang /analyzer.
# Endpoint phải theo chuẩn OpenAI /chat/completions.
#   AI_BASE_URL : base URL kèm version, vd https://api.ai-box.vn/v1
#   AI_API_KEY  : bearer token
#   AI_MODEL    : tên model. Với ai-box:
#                   deepseek-v4-flash / deepseek-v4-pro     (reasoning luôn bật)
#                   deepseek-v4-flash[1m] / *-pro[1m]       (1M context window)
#                   claude-opus-4.8-thinking / *-thinking   (Claude reasoning, trả SSE)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── AI reasoning (tùy chọn) ──────────────────────────────────────────────────
# AI_REASONING_EFFORT : mức suy luận cho model thinking. ai-box chấp nhận:
#                         low < medium < high < max < xhigh
#                       Để trống → dùng default của model. Giá trị sai → bỏ qua.
#                       "max thinking" của v4-flash = đặt max (hoặc xhigh).
AI_REASONING_EFFORT=
# AI_EXTRA_BODY : JSON object merge thẳng vào request body (escape hatch cho
#                 param provider-specific). Vd: {"thinking":{"type":"enabled"}}
#                 JSON sai cú pháp → bỏ qua an toàn.
AI_EXTRA_BODY=
